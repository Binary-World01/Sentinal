# ══════════════════════════════════════════════════════════════════════════════
# AP Payment Fraud Sentinel — Template Configuration (.env.example)
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. RocketRide Pipeline Engine ─────────────────────────────────────────────
# Local Mode (VS Code extension starts local WebSocket daemon)
ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_APIKEY=local

# Cloud Mode
# ROCKETRIDE_URI=wss://cloud.rocketride.ai/your-team-endpoint
# ROCKETRIDE_APIKEY=your_cloud_api_key

# ── 2. Primary AI Engine: Groq ────────────────────────────────────────────────
# Free Tier: console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# ── 3. Failover AI Engine: Google Gemini ──────────────────────────────────────
# Free Tier: aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# ── 4. Supabase Database & Auth (Multi-Tenancy) ───────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── 5. Payment Gateway: Stripe Connect ────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# ── 6. Payment Gateway: RazorpayX ─────────────────────────────────────────────
# Dashboard: https://x.razorpay.com
RAZORPAYX_KEY_ID=rzp_test_your_key_id_here
RAZORPAYX_KEY_SECRET=your_razorpayx_key_secret_here
RAZORPAYX_WEBHOOK_SECRET=whsec_your_razorpayx_webhook_secret_here

# ── 7. IMAP Automated Email Ingestion (APScheduler Worker) ───────────────────
# IMAP credentials for fetching invoices from AP inbox
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=invoices@yourcompany.com
IMAP_PASS=your_app_specific_password_here
IMAP_POLL_INTERVAL_SEC=120

# ── 8. Outbound Email Alerts (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASS=your_smtp_app_password_here
ALERT_EMAIL=ap-security@yourcompany.com

# ── 9. Server Settings ────────────────────────────────────────────────────────
SENTINEL_ADMIN_EMAIL=admin@sentinel.finance
PORT=8000
HOST=0.0.0.0
