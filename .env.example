# ── RocketRide Connection ─────────────────────────────────────────────────────
# Local mode (VS Code extension auto-fills these when you click Connect)
ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_APIKEY=your_local_api_key_from_vscode_extension

# Cloud mode (after redeeming promo code INDIAHACK1 at cloud.rocketride.ai)
# ROCKETRIDE_URI=wss://cloud.rocketride.ai/your-team-endpoint
# ROCKETRIDE_APIKEY=your_cloud_api_key


# ── PRIMARY: Groq (FREE — 14,400 req/day, fastest inference) ──────────────────
# Sign up free (no credit card): https://console.groq.com → API Keys → Create
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant


# ── FALLBACK: Google Gemini (FREE — 1,500 req/day, 1M tokens/min) ─────────────
# Sign up free (no credit card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-1.5-flash
